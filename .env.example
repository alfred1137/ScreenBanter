# .env.example - Template for ScreenBanter environment variables

# Google Gemini API Keys (Comma-separated for rotation and high availability)
# Get keys at: https://aistudio.google.com/app/apikey
# Format: KEY1,KEY2,KEY3
GEMINI_KEYS="your_first_api_key_here,your_second_api_key_here"

# Deprecated: GEMINI_KEY (Use GEMINI_KEYS instead for multi-key support)
# GEMINI_KEY="your_single_gemini_api_key_here"

# Optional: Local path to VibeVoice model
VIBEVOICE_MODEL_PATH="./models/VibeVoice-Realtime-0.5B"